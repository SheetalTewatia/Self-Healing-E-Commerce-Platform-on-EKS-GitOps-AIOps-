# ─────────────────────────────────────────────────────────────
#  CREDENTIALS TEMPLATE — copy this to .env and fill in values
#  .env is listed in .gitignore and will NEVER be committed
# ─────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme_use_strong_password
MONGO_PORT=27017

# ── AWS (fill these after running terraform apply) ────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ECR_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com
JENKINS_EC2_IP=
SONARQUBE_EC2_IP=
EKS_CLUSTER_NAME=devops-demo-cluster
KEY_PAIR_NAME=devops-key

# ── SonarQube ─────────────────────────────────────────────────
SONAR_HOST_URL=http://<sonarqube-ip>:9000
SONAR_TOKEN=

# ── GitHub ────────────────────────────────────────────────────
GITHUB_USERNAME=your-github-username
SOURCE_REPO_URL=https://github.com/your-username/ecommerce-app.git
CONFIG_REPO_URL=https://github.com/your-username/ecommerce-config.git

# ── Jenkins ───────────────────────────────────────────────────
JENKINS_URL=http://<jenkins-ip>:8080
JENKINS_GITHUB_CREDS_ID=github-creds
JENKINS_SONAR_CREDS_ID=sonarqube-token
